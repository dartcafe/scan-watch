# Copy to .env and adjust; compose.yml lists what is used from here.

## Docker

# Host folders for the PDFs and for the settings (incl. profiles). Create them
# first; both must be writable for PUID:PGID:  mkdir -p scans config
SCANS_DIR=./scans
CONFIG_DIR=./config
# User the container runs as (Docker only), usually your own: id -u / id -g.
# PDFs and settings on the host belong to it.
PUID=1000
PGID=1000
# Host port of the web interface
WEB_PORT=8080
# Time zone, used for the file names
TZ=Europe/Berlin
# Start again after a reboot; "no" for a test setup that should not come back
#RESTART=unless-stopped

## scan-watch
#
# These are fixed: read-only in the web interface and not changed by profiles.
# Color, resolution, split, target, tags etc. are chosen in the web interface.

# Scanner address (IP or host name). Leave it empty to enter it on the
# configuration page of the web interface instead.
SCAN_WATCH_HOST=

# Paperless-ngx address as scan-watch reaches it
SCAN_WATCH_PAPERLESS_URL=http://paperless:8000
# API token from Paperless: profile menu -> API Auth Token
SCAN_WATCH_PAPERLESS_TOKEN=
# Address for links in the browser, if it differs from the one above
#SCAN_WATCH_PAPERLESS_PUBLIC_URL=https://paperless.example.lan

# Web interface password (basic auth, any user name)
SCAN_WATCH_WEB_PASSWORD=

# Optional:
# Minutes without paper until scan-watch pauses so the scanner can sleep (0 = never)
#SCAN_WATCH_AUTO_PAUSE=30
# Canon DR-S150 only, experimental: SNMP v1 community of the scanner. The automatic
# pause then ends by itself when paper is inserted (see README).
#SCAN_WATCH_SNMP_COMMUNITY=public
# SHA-256 fingerprint of a self-signed Paperless certificate. Usually not needed:
# the web interface shows the fingerprint and pins it with one click.
#SCAN_WATCH_PAPERLESS_TLS_PIN=
